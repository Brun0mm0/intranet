# Copiar este archivo como .env.development.local y completar los valores.
# Ese archivo no se sube al repo (.gitignore: *.local).

# URL de la API en desarrollo. En el build de producción, si no se define, se usa /api.
VITE_API_URL=http://servidor-de-desarrollo:puerto/

# Entrar sin login con un usuario simulado (solo para desarrollo).
VITE_DEV_BYPASS_AUTH=false
VITE_DEV_MOCK_ROL=1
VITE_DEV_MOCK_USUARIO=dev
